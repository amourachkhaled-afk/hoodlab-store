# Copiez ce fichier en .env puis renseignez vos clés Stripe (test d'abord).
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Optionnel : secret de webhook (Stripe Dashboard > Développeurs > Webhooks)
# URL du webhook : http://localhost:4242/api/webhook
# Événement à écouter : checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

PORT=4242
